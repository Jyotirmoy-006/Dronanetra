# ---- Backend ----
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/processed/engine_twin.db
LOG_LEVEL=INFO

# CAN / telemetry interface
TELEMETRY_MODE=simulated          # simulated | can | serial
CAN_CHANNEL=can0
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=115200

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/engine
